+	/* The panel size is the boot video's (ADT sweet-fbcon): 1080x2340 on the
+	 * 6T, 1080x2280 on the OnePlus 6. AppleCLCD centres the iPhone X plane on
+	 * the same numbers, so the picture and the digitizer share one offset. */
+	PE_Video video;
+	PE_current_console(&video);
+	int panelW = video.v_width ? (int)video.v_width : 1080;
+	int panelH = video.v_height ? (int)video.v_height : 2340;
+	fLogicalW = native ? panelW : 1125;
+	fLogicalH = native ? panelH : 2436;
+	fOffX = (fLogicalW - panelW) / 2;
+	fOffY = (fLogicalH - panelH) / 2;
