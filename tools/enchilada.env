# OnePlus 6 (enchilada), Qualcomm SDM845. Source this from bash, or
#   BOARD_ENV=tools/enchilada.env tools/build-fajita.sh
# Values measured on the phone (live FDT, GPT, sysfs) unless noted; the
# OnePlus 6 shares the 6T's board design, so most of tools/fajita.env holds.

SOC=sdm845
# The ABL continuous-splash buffer: same address and size as on the 6T, the
# panel is 2280 rows instead of 2340 (same width, stride and format).
FB_BASE=0x9d400000
FB_SIZE=0x02400000
FB_BLOCK=0x9c000000          # 32 MiB block that contains FB_BASE
FB_OFFSET=0x1400000          # FB_BASE - FB_BLOCK
FB_W=1080
FB_H=2280
FB_STRIDE=4320
PANEL_MM_W=68                # qcom,mdss-pan-physical-*-dimension
PANEL_MM_H=145
# Panel: samsung sofef00_m, command mode with TE, no DSC, 60 Hz
# (msm_drm.dsi_display0=dsi_samsung_sofef00_m_cmd_display); never programmed
# by the port, ABL leaves it scanning out the splash buffer.

GICD=0x17a00000
GICR=0x17a60000
GICR_STRIDE=0x20000
VTIMER_INTID=19

UFS=0x1d84000
UFS_PHY=0x1d87000
PSHOLD=0x0c264000
IMEM_RESTART_REASON=0x146bf65c

RAM_HIGH_BASE=0x100000000
# Live FDT of this unit (8 GB, SDM845 v2.1): /memory = 0x80000000+0x100000000
# and 0x180000000+0xfc8a0000; every reserved-memory carve-out is below
# 0xad200000. Identical to the 6T unit the fajita tree was measured on.
# Re-measure on any other unit (6 GB models differ): tools/enchilada-facts.py.
RAM_HIGH_SIZE=0x17c8a0000
# Board identity: qcom,msm-id <321 0x20001>, qcom,board-id <8 0 17819 22>
# (project 17819 = OnePlus 6, hw 22 = PVT). ABL picks the SDM845 v2.1 SoC
# DTB (dtb_idx 2 of the stock Image.gz-dtb table) and merges dtbo entry 5.
PROJECT_ID=17819
HW_ID=22
DTB_DEFAULT=dtb/boot_b_unpacked/enchilada2.dtb

# A55 MPIDR 0x000 0x100 0x200 0x300
# A75 MPIDR 0x400 0x500 0x600 0x700
CPU_A55_FREQ=1766400000
CPU_A75_FREQ=2803200000

# Touch: Synaptics S3320 (RMI4) on QUPv3 SE12 (i2c12 @ 0xa90000), same wiring
# as the 6T; only the sensor's Y range (panel 2280 rows) differs.
TOUCH_I2C_BASE=0xa90000
TOUCH_I2C_ADDR=0x20
TOUCH_IRQ_GPIO=125
TOUCH_RESET_GPIO=99
TOUCH_VIO_GPIO=88
TOUCH_VDD_LDO=28             # pm8998_l28 (rpmh ldoa28) 3.008 V

# Keys: PM8998 PON (power, volume down also on RESIN), PMIC GPIOs
VOL_DOWN_PMIC_GPIO=5
VOL_UP_PMIC_GPIO=6

# Storage: Samsung KLUDG4U1EA-B0C1 (128 GB) UFS 2.1; userdata = sda17,
# first 4 KiB block 0x186f40, 110 GiB (same as the 6T).
USERDATA_DEV=/dev/block/sda17
